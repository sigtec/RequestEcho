{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "RequestEcho": "Information"
    }
  },
  "AllowedHosts": "*",

  "Echo": {
    "WireLog": true,
    "WireLogMaxBytes": 65536,
    "LogToConsole": false,
    "ServerCertificate": {
      "AutoSelect": true,
      "Location": "LocalMachine",
      "Store": "My",
      "Subject": "",
      "Thumbprint": ""
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      },
      "Https": {
        "Url": "https://0.0.0.0:5443",
        "Protocols": "Http1AndHttp2",
        "ClientCertificateMode": "AllowCertificate"
      }
    }
  }
}
